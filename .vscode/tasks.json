{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FTC: Build and Install (Deploy)",
            "type": "shell",
            "command": "./gradlew :TeamCode:removeSlothRemote installDebug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "windows": {
                "command": ".\\gradlew.bat :TeamCode:removeSlothRemote installDebug"
            }
        },
        {
            "label": "FTC: Hot Reload (Sloth)",
            "type": "shell",
            "command": "./gradlew :TeamCode:deploySloth",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "windows": {
                "command": ".\\gradlew.bat :TeamCode:deploySloth"
            }
        },
        {
            "label": "FTC: Clean Project",
            "type": "shell",
            "command": "./gradlew clean",
            "problemMatcher": [],
            "windows": {
                "command": ".\\gradlew.bat clean"
            }
        },
        {
            "label": "FTC: Connect via ADB (Wi-Fi)",
            "type": "shell",
            "command": "adb connect 192.168.43.1:5555",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "FTC: ADB Devices",
            "type": "shell",
            "command": "adb devices",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "FTC: ADB Disconnect",
            "type": "shell",
            "command": "adb disconnect",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "FTC: Logcat",
            "type": "shell",
            "command": "adb logcat",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        }
    ]
}
